PORT=3000

# Sent as part of the User-Agent on requests to the Nominatim geocoding API,
# as required by its usage policy: https://operations.osmfoundation.org/policies/nominatim/
GEOCODE_CONTACT=you@example.org

# Milliseconds to wait between requests when bulk-geocoding scraped candidates
# (Nominatim's policy requires at least 1000; default is more conservative).
GEOCODE_INTERVAL_MS=5000
