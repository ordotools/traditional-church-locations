PORT=3000

# Sent as part of the User-Agent on requests to the Nominatim geocoding API,
# as required by its usage policy: https://operations.osmfoundation.org/policies/nominatim/
GEOCODE_CONTACT=you@example.org

# Milliseconds to wait between requests when bulk-geocoding scraped candidates
# (Nominatim's policy requires at least 1000; default is more conservative).
GEOCODE_INTERVAL_MS=5000

# Admin panel login (single account — see ROADMAP for multi-user/roles).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs the session cookie. Set this to a long random string in production
# (e.g. `openssl rand -hex 32`) — anyone who knows it can forge admin sessions.
SESSION_SECRET=change-me-too

# Where the SQLite file lives. Defaults to ./data. In production, point this
# at a mounted persistent volume so data survives redeploys (see README).
DATA_DIR=./data
