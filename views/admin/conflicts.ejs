<%- include('../partials/header', { title: 'Conflicts', bodyClass: 'wide' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<p class="muted">Scraped candidates that look like they might already be on the map, held here instead of
   publishing automatically: either matched to an existing pin under a different organization
   (post-geocode), or flagged as an ambiguous possible duplicate before geocoding even ran. Either
   the location changed hands (update the existing pin), or it's genuinely a different place
   (publish as a separate pin) — confirming either action geocodes it first if it hasn't been yet.</p>

<% if (candidates.length === 0) { %>
  <p class="muted">No conflicts awaiting review.</p>
<% } %>

<% candidates.forEach(function(c) { %>
  <div class="card">
    <div class="dup-columns">
      <div class="dup-column">
        <div class="muted">New candidate · from <a class="muted" href="<%= c.source_url %>"><%= c.source_url %></a></div>
        <strong><%= c.title %></strong>
        <div class="muted"><%= c.raw_address %></div>
        <div class="muted"><%= c.organization_name || '—' %></div>
      </div>
      <div class="dup-column">
        <div class="muted">Existing pin</div>
        <strong><%= c.existing_title %></strong>
        <div class="muted"><%= c.existing_address %></div>
        <div class="muted"><%= c.existing_organization_name || '—' %></div>
      </div>
    </div>

    <% if (c.duplicate_score != null) { %>
      <div class="muted" style="margin-top:0.5rem;">
        <%= c.latitude == null ? 'Flagged before geocoding' : 'Flagged' %> — suggested match confidence: <%= Math.round(c.duplicate_score * 100) %>%
      </div>
    <% } %>

    <div class="candidate-actions" style="margin-top:0.75rem;">
      <form method="post" action="/admin/conflicts/<%= c.id %>/update-existing" style="display:inline;">
        <button type="submit">Same place — update existing pin</button>
      </form>
      <form method="post" action="/admin/conflicts/<%= c.id %>/not-duplicate" style="display:inline;">
        <button type="submit" class="secondary">Not a duplicate — publish separately</button>
      </form>
      <form method="post" action="/admin/conflicts/<%= c.id %>/reject" style="display:inline;">
        <button type="submit" class="secondary" title="Keeps the existing pin as-is. Remembers this exact address/title/organization from this source so it won't ask again — unless a future scrape names a different organization here.">Reject candidate</button>
      </form>
    </div>
  </div>
<% }) %>

<%- include('../partials/footer') %>
