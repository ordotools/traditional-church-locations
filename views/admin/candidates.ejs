<%- include('../partials/header', { title: 'Review Candidates' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<% if (queue.running) { %>
  <meta http-equiv="refresh" content="4">
  <p>Geocoding in the background: <%= queue.done %> / <%= queue.total %> done
     <% if (queue.failed) { %>(<%= queue.failed %> not found)<% } %> — this page refreshes itself.</p>
<% } else if (queue.total) { %>
  <p class="muted">Last background geocoding run: <%= queue.done %> / <%= queue.total %> processed
     <% if (queue.failed) { %>, <%= queue.failed %> not found<% } %>.</p>
<% } %>

<% if (candidates.length === 0) { %>
  <p class="muted">No pending candidates. <a href="/admin/scrape">Scrape a URL</a> to find some.</p>
<% } else { %>
  <form method="post" action="/admin/candidates/geocode-all">
    <button type="submit" <%= queue.running ? 'disabled' : '' %>>
      Geocode All Pending (<%= candidates.filter(function(c){ return c.latitude === null; }).length %> ungeocoded)
    </button>
  </form>
<% } %>

<% candidates.forEach(function(c) { %>
  <form method="post" action="/admin/candidates/<%= c.id %>/confirm">
    <div class="muted">
      <%= c.precision === 'exact' ? 'Address' : (c.precision === 'city' ? 'City-level (approximate)' : 'State-level (approximate)') %>
      <% if (c.organization_name) { %> · <%= c.organization_name %> (<%= c.organization_abbreviation %>)<% } %>
      · from <%= c.source_url %>
    </div>
    <div><strong><%= c.raw_address %></strong></div>
    <div class="muted">
      <% if (c.latitude !== null) { %>
        Geocoded to <%= c.latitude.toFixed(5) %>, <%= c.longitude.toFixed(5) %>
      <% } else { %>
        Not yet geocoded — confirming will geocode it now, or wait for the background job.
      <% } %>
    </div>

    <label for="title-<%= c.id %>">Title</label>
    <input type="text" id="title-<%= c.id %>" name="title" value="<%= c.title || '' %>" placeholder="e.g. Queen of All Saints Chapel" required>

    <label for="latitude-<%= c.id %>">Latitude / Longitude <span class="muted">(optional override)</span></label>
    <div style="display:flex;gap:0.5rem;">
      <input type="text" id="latitude-<%= c.id %>" name="latitude" placeholder="Latitude">
      <input type="text" id="longitude-<%= c.id %>" name="longitude" placeholder="Longitude">
    </div>

    <button type="submit">Confirm</button>
  </form>
  <form method="post" action="/admin/candidates/<%= c.id %>/reject" style="border:none;padding:0;margin:-1rem 0 1.5rem;">
    <button type="submit" class="secondary">Reject</button>
  </form>
<% }) %>

<%- include('../partials/footer') %>
