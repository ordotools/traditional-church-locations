<%- include('../partials/header', { title: 'Review Candidates' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<% if (candidates.length === 0) { %>
  <p class="muted">No pending candidates. <a href="/admin/scrape">Scrape a URL</a> to find some.</p>
<% } %>

<% candidates.forEach(function(c) { %>
  <form method="post" action="/admin/candidates/<%= c.id %>/confirm">
    <div><strong><%= c.raw_address %></strong></div>
    <div class="muted">
      From <%= c.source_url %><br>
      <% if (c.organization_name) { %>Organization: <%= c.organization_name %> (<%= c.organization_abbreviation %>)<br><% } %>
      <% if (c.latitude !== null) { %>
        Geocoded to <%= c.latitude.toFixed(5) %>, <%= c.longitude.toFixed(5) %>
      <% } else { %>
        Could not be geocoded — cannot be confirmed.
      <% } %>
    </div>

    <label for="title-<%= c.id %>">Title</label>
    <input type="text" id="title-<%= c.id %>" name="title" placeholder="e.g. Queen of All Saints Chapel" required>

    <% if (c.latitude === null) { %>
      <label for="latitude-<%= c.id %>">Latitude / Longitude <span class="muted">(required — this address could not be geocoded)</span></label>
      <div style="display:flex;gap:0.5rem;">
        <input type="text" id="latitude-<%= c.id %>" name="latitude" placeholder="Latitude">
        <input type="text" id="longitude-<%= c.id %>" name="longitude" placeholder="Longitude">
      </div>
    <% } %>

    <button type="submit">Confirm</button>
  </form>
  <form method="post" action="/admin/candidates/<%= c.id %>/reject" style="border:none;padding:0;margin:-1rem 0 1.5rem;">
    <button type="submit" class="secondary">Reject</button>
  </form>
<% }) %>

<%- include('../partials/footer') %>
