<%- include('../partials/header', { title: 'Geolocation Queue', bodyClass: 'wide' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<div id="queue-status"
  <% if (queue.running) { %>hx-get="/admin/candidates" hx-select="#queue-status" hx-target="this" hx-swap="outerHTML" hx-trigger="every 4s"<% } %>>
  <% if (queue.running) { %>
    <p>Geocoding in the background: <%= queue.done %> / <%= queue.total %> done
       <% if (queue.failed) { %>(<%= queue.failed %> not found)<% } %> — this updates itself.</p>
  <% } else if (queue.total) { %>
    <p class="muted">Last background geocoding run: <%= queue.done %> / <%= queue.total %> processed
       <% if (queue.failed) { %>, <%= queue.failed %> not found<% } %>.</p>
  <% } %>
</div>


<%
  var readyToConfirm = candidates.filter(function(c){ return c.latitude !== null && c.title; });
  var ungeocoded = candidates.filter(function(c){ return c.latitude === null; });
%>

<% if (candidates.length === 0) { %>
  <p class="muted">No candidates awaiting geolocation. Approve some from <a href="/admin/review">Scrape Review</a> first.</p>
<% } else { %>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;">
    <form method="post" action="/admin/candidates/geocode-all">
      <button type="submit" <%= queue.running || ungeocoded.length === 0 ? 'disabled' : '' %>>
        Geocode All Pending (<%= ungeocoded.length %> ungeocoded)
      </button>
    </form>
    <% if (!queue.running && readyToConfirm.length > 0) { %>
      <form method="post" action="/admin/candidates/confirm-all" hx-confirm="Confirm <%= readyToConfirm.length %> geocoded candidate(s) as pins?">
        <button type="submit">Confirm All Geolocated (<%= readyToConfirm.length %> ready)</button>
      </form>
    <% } %>
    <form id="bulk-delete" method="post" action="/admin/candidates/bulk-delete"
      hx-confirm="Delete the selected candidates? This cannot be undone.">
      <label style="display:inline;font-variant:normal;font-size:inherit;color:inherit;">
        <input type="checkbox" onclick="document.querySelectorAll('.candidate-select').forEach(function(cb){ cb.checked = this.checked; }, this)">
        Select all
      </label>
      <button type="submit" class="secondary">Delete Selected</button>
    </form>
  </div>
<% } %>

<%
  var precisionLabels = {
    exact: 'Address',
    postal: 'Postal code-level (approximate)',
    city: 'City-level (approximate)',
    state: 'State-level (approximate)',
    country: 'Country-level (approximate)',
  };
%>
<% candidates.forEach(function(c) { %>
  <div class="candidate-card">
    <div class="muted candidate-meta">
      <input class="candidate-select" type="checkbox" form="bulk-delete" name="ids" value="<%= c.id %>" aria-label="Select for bulk delete">
      <%= precisionLabels[c.precision] || c.precision %>
      <% if (c.organization_name) { %> · <%= c.organization_name %> (<%= c.organization_abbreviation %>)<% } %>
      · from <a class="muted" href="<%= c.source_url %>"><%= c.source_url %></a>
      <% if (c.latitude !== null) { %>
        · geocoded to <%= c.latitude.toFixed(5) %>, <%= c.longitude.toFixed(5) %>
      <% } else { %>
        · not yet geocoded — correct the address below and confirm to retry
      <% } %>
    </div>

    <form method="post" action="/admin/candidates/<%= c.id %>/confirm">
      <div class="field-grid">
        <div>
          <label for="title-<%= c.id %>">Title</label>
          <input type="text" id="title-<%= c.id %>" name="title" value="<%= c.title || '' %>" placeholder="e.g. Queen of All Saints Chapel" required>
        </div>
        <div>
          <label for="address-<%= c.id %>">Address</label>
          <input type="text" id="address-<%= c.id %>" name="address" value="<%= c.raw_address %>" required>
        </div>
        <div>
          <label for="latitude-<%= c.id %>">Latitude</label>
          <input type="text" id="latitude-<%= c.id %>" name="latitude" placeholder="optional override">
        </div>
        <div>
          <label for="longitude-<%= c.id %>">Longitude</label>
          <input type="text" id="longitude-<%= c.id %>" name="longitude" placeholder="optional override">
        </div>
      </div>

      <div class="candidate-actions">
        <button type="submit">Confirm</button>
        <button type="submit" formaction="/admin/candidates/<%= c.id %>/reject" formnovalidate class="secondary">Reject</button>
      </div>
    </form>
  </div>
<% }) %>

<%- include('../partials/footer') %>
