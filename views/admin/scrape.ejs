<%- include('../partials/header', { title: 'Scrape URL' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<p class="muted">
  Fetches the page and looks for Mass center listings: title, address (or city/state
  if no street address is given), and organization. Unrecognized organization
  abbreviations are created automatically — rename them on the Organizations page.
  Nothing is geocoded yet and nothing is added to the map until you review and confirm
  candidates, either one at a time or with the background "Geocode All Pending" job.
</p>

<form method="post" action="/admin/scrape">
  <label for="url">URL</label>
  <input type="url" id="url" name="url" placeholder="https://example.org/locations" required>

  <label for="organization_id">Organization <span class="muted">(optional — only needed if this page doesn't label each listing with an organization code)</span></label>
  <select id="organization_id" name="organization_id">
    <option value="">Detect automatically per listing</option>
    <% organizations.forEach(function(org) { %>
      <option value="<%= org.id %>"><%= org.name %> (<%= org.abbreviation %>)</option>
    <% }) %>
  </select>

  <button type="submit">Scrape</button>
</form>

<h2>Automatic Re-scraping</h2>
<p class="muted">
  On the interval below, every saved URL is re-scraped unattended. Listings that already match an existing
  pin (same organization, same address) are skipped as duplicates. New or changed listings are geocoded and
  auto-resolved: a pin under a different organization at the same address goes to the
  <a href="/admin/conflicts">Conflicts</a> queue for review, everything else publishes automatically.
</p>

<form method="post" action="/admin/scrape/schedule">
  <label><input type="checkbox" name="enabled" <%= scrapeStatus.enabled ? 'checked' : '' %>> Enabled</label>

  <label for="interval_hours">Every</label>
  <input type="number" id="interval_hours" name="interval_hours" min="1" value="<%= scrapeStatus.interval_hours %>" style="width:5rem;display:inline-block;"> hours

  <button type="submit">Save</button>
</form>

<p class="muted">
  <% if (scrapeStatus.running) { %>
    Running now<% if (scrapeStatus.phase === 'scraping' && scrapeStatus.sourcesTotal) { %>
      — <%= scrapeStatus.sourcesDone %>/<%= scrapeStatus.sourcesTotal %> sources scraped<% } else if (scrapeStatus.phase === 'geocoding') { %> — geocoding new candidates<% } else if (scrapeStatus.phase === 'resolving') { %> — resolving matches<% } %>…
  <% } else if (scrapeStatus.last_run_at) { %>
    Last run <%= scrapeStatus.last_run_at %> (<%= scrapeStatus.run_count %> run<%= scrapeStatus.run_count === 1 ? '' : 's' %> total)
    <% const summary = scrapeStatus.last_run_summary ? JSON.parse(scrapeStatus.last_run_summary) : null; %>
    <% if (summary) { %>
      — <%= summary.newCandidates %> new, <%= summary.skippedDuplicates %> skipped as duplicates,
      <%= summary.confirmed %> auto-confirmed, <%= summary.newPins %> new pins,
      <%= summary.conflicts %> sent to conflicts<% if (summary.sourcesFailed) { %>, <%= summary.sourcesFailed %> source(s) failed<% } %>.
    <% } %>
  <% } else { %>
    Never run yet.
  <% } %>
</p>

<form method="post" action="/admin/scrape/schedule/run">
  <button type="submit" class="secondary" <%= scrapeStatus.running ? 'disabled' : '' %>>Run Now</button>
</form>

<h2>Crawl Rules</h2>
<p class="muted">
  For a page that's a link index rather than a directory — every entry links out to that location's own page
  or site instead of listing an address itself (like an FSSP-style "locations" map or list page). Scraping a
  matching URL follows every link matching the selector below and extracts from each destination instead of
  the index page. A rule also applies to any page it links to that's <em>also</em> a link index, so one rule
  on the page people actually land on is usually enough even if the real listing lives one click deeper.
</p>

<form method="post" action="/admin/scrape/crawl-rules">
  <label for="crawl-rule-url">URL</label>
  <input type="url" id="crawl-rule-url" name="url" placeholder="https://example.org/locations" required>

  <label for="crawl-rule-selector">Link selector <span class="muted">(CSS selector matching the links to follow)</span></label>
  <input type="text" id="crawl-rule-selector" name="link_selector" placeholder="article a[href]" required>

  <button type="submit">Add Rule</button>
</form>

<% if (crawlRules.length) { %>
  <% crawlRules.forEach(function(r) { %>
    <div class="card">
      <strong><%= r.page_key %></strong>
      <div class="muted">Selector: <code><%= r.link_selector %></code></div>
      <form method="post" action="/admin/scrape/crawl-rules/<%= r.id %>/delete" style="margin-top:0.5rem;">
        <button type="submit" class="secondary">Remove</button>
      </form>
    </div>
  <% }) %>
<% } %>

<% if (sources.length) { %>
  <h2>Previously Scraped URLs</h2>
  <p class="muted">Recorded automatically each time you scrape a URL. Add a title and note as a reminder of
     what each page contains, then scrape it again with one click instead of tracking the site down again.</p>

  <% sources.forEach(function(s) { %>
    <div class="card">
      <% if (s.title) { %><strong><%= s.title %></strong><br><% } %>
      <a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.url %></a>
      <div class="muted">
        <%= s.last_scraped_at ? 'Last scraped ' + s.last_scraped_at : 'Never scraped' %>
        <% if (s.note) { %> · <%= s.note %><% } %>
      </div>

      <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
        <form method="post" action="/admin/scrape/sources/<%= s.id %>/run">
          <button type="submit">Scrape Again</button>
        </form>
        <form method="post" action="/admin/scrape/sources/<%= s.id %>/delete" hx-confirm="Remove this saved URL from the list?">
          <button type="submit" class="secondary">Remove</button>
        </form>
      </div>

      <details style="margin-top:0.5rem;">
        <summary>Edit title, note, or default organization</summary>
        <form method="post" action="/admin/scrape/sources/<%= s.id %>">
          <label for="title-<%= s.id %>">Title</label>
          <input type="text" id="title-<%= s.id %>" name="title" value="<%= s.title || '' %>" placeholder="e.g. SSPX chapel directory">

          <label for="note-<%= s.id %>">Note</label>
          <input type="text" id="note-<%= s.id %>" name="note" value="<%= s.note || '' %>" placeholder="e.g. table layout, one row per chapel, no city/state fallback needed">

          <label for="organization_id-<%= s.id %>">Organization <span class="muted">(optional default for future scrapes)</span></label>
          <select id="organization_id-<%= s.id %>" name="organization_id">
            <option value="">Detect automatically per listing</option>
            <% organizations.forEach(function(org) { %>
              <option value="<%= org.id %>" <%= String(org.id) === String(s.organization_id) ? 'selected' : '' %>>
                <%= org.name %> (<%= org.abbreviation %>)
              </option>
            <% }) %>
          </select>

          <button type="submit" class="secondary">Save</button>
        </form>
      </details>

      <% const decisions = decisionsBySource[s.id] || []; %>
      <% if (decisions.length) { %>
        <details style="margin-top:0.5rem;">
          <summary>Locations (<%= decisions.length %>)</summary>
          <p class="muted">
            Remembered from past scrapes of this source. An accepted or skipped location is applied automatically
            the next time this source is scraped — toggle it here if that call was wrong.
          </p>
          <table>
            <thead>
              <tr><th>Title</th><th>Address</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
              <% decisions.forEach(function(d) { %>
                <tr>
                  <td><%= d.title || '(no title found)' %></td>
                  <td><%= d.raw_address %></td>
                  <td><%= d.status === 'approved' ? 'Accepted' : 'Skipped' %></td>
                  <td>
                    <form method="post" action="/admin/scrape/sources/<%= s.id %>/decisions/<%= d.id %>">
                      <button type="submit" class="secondary">
                        <%= d.status === 'approved' ? 'Mark skipped' : 'Mark accepted' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      <% } %>
    </div>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>
