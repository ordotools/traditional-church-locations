<%- include('../partials/header', { title: 'Scrape URL' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<p class="muted">
  Fetches the page and looks for Mass center listings: title, address (or city/state
  if no street address is given), and organization. Unrecognized organization
  abbreviations are created automatically — rename them on the Organizations page.
  Nothing is geocoded yet and nothing is added to the map until you review and confirm
  candidates, either one at a time or with the background "Geocode All Pending" job.
</p>

<form method="post" action="/admin/scrape">
  <label for="url">URL</label>
  <input type="url" id="url" name="url" placeholder="https://example.org/locations" required>

  <label for="organization_id">Organization <span class="muted">(optional — only needed if this page doesn't label each listing with an organization code)</span></label>
  <select id="organization_id" name="organization_id">
    <option value="">Detect automatically per listing</option>
    <% organizations.forEach(function(org) { %>
      <option value="<%= org.id %>"><%= org.name %> (<%= org.abbreviation %>)</option>
    <% }) %>
  </select>

  <button type="submit">Scrape</button>
</form>

<% if (sources.length) { %>
  <h2>Previously Scraped URLs</h2>
  <p class="muted">Recorded automatically each time you scrape a URL. Add a title and note as a reminder of
     what each page contains, then scrape it again with one click instead of tracking the site down again.</p>

  <% sources.forEach(function(s) { %>
    <div class="card">
      <% if (s.title) { %><strong><%= s.title %></strong><br><% } %>
      <a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.url %></a>
      <div class="muted">
        <%= s.last_scraped_at ? 'Last scraped ' + s.last_scraped_at : 'Never scraped' %>
        <% if (s.note) { %> · <%= s.note %><% } %>
      </div>

      <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
        <form method="post" action="/admin/scrape/sources/<%= s.id %>/run">
          <button type="submit">Scrape Again</button>
        </form>
        <form method="post" action="/admin/scrape/sources/<%= s.id %>/delete" hx-confirm="Remove this saved URL from the list?">
          <button type="submit" class="secondary">Remove</button>
        </form>
      </div>

      <details style="margin-top:0.5rem;">
        <summary>Edit title, note, or default organization</summary>
        <form method="post" action="/admin/scrape/sources/<%= s.id %>">
          <label for="title-<%= s.id %>">Title</label>
          <input type="text" id="title-<%= s.id %>" name="title" value="<%= s.title || '' %>" placeholder="e.g. SSPX chapel directory">

          <label for="note-<%= s.id %>">Note</label>
          <input type="text" id="note-<%= s.id %>" name="note" value="<%= s.note || '' %>" placeholder="e.g. table layout, one row per chapel, no city/state fallback needed">

          <label for="organization_id-<%= s.id %>">Organization <span class="muted">(optional default for future scrapes)</span></label>
          <select id="organization_id-<%= s.id %>" name="organization_id">
            <option value="">Detect automatically per listing</option>
            <% organizations.forEach(function(org) { %>
              <option value="<%= org.id %>" <%= String(org.id) === String(s.organization_id) ? 'selected' : '' %>>
                <%= org.name %> (<%= org.abbreviation %>)
              </option>
            <% }) %>
          </select>

          <button type="submit" class="secondary">Save</button>
        </form>
      </details>
    </div>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>
