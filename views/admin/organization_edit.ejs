<%- include('../partials/header', { title: 'Edit Organization' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<form method="post" action="/admin/organizations/<%= organization.id %>">
  <label for="name">Name</label>
  <input type="text" id="name" name="name" value="<%= organization.name %>" required>

  <label for="abbreviation">Abbreviation</label>
  <input type="text" id="abbreviation" name="abbreviation" value="<%= organization.abbreviation %>" required>

  <label for="color">Color</label>
  <input type="color" id="color" name="color" value="<%= organization.color %>">

  <label for="status">Status <span class="muted">(default for this org's locations, unless a location overrides it)</span></label>
  <select id="status" name="status">
    <% statuses.forEach(function(s) { %>
      <option value="<%= s %>" <%= s === organization.status ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <button type="submit">Save</button>
</form>

<%- include('../partials/footer') %>
