<%- include('../partials/header', { title: 'Edit Mass Center' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>
<% if (notice) { %><div class="notice"><%= notice %></div><% } %>

<form method="post" action="/admin/mass-centers/<%= massCenter.id %>">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= massCenter.title %>" required>

  <label for="address">Address <span class="muted">(changing this re-geocodes on save, unless you set lat/lng below)</span></label>
  <input type="text" id="address" name="address" value="<%= massCenter.address %>" required>

  <label for="organization_id">Organization</label>
  <select id="organization_id" name="organization_id">
    <option value="">—</option>
    <% organizations.forEach(function(org) { %>
      <option value="<%= org.id %>" <%= String(org.id) === String(massCenter.organization_id) ? 'selected' : '' %>>
        <%= org.name %> (<%= org.abbreviation %>)
      </option>
    <% }) %>
  </select>

  <label for="status">Status</label>
  <select id="status" name="status">
    <option value="" <%= !massCenter.status ? 'selected' : '' %>>
      Inherit from organization<% if (massCenter.organization_status) { %> (currently <%= massCenter.organization_status %>)<% } %>
    </option>
    <% statuses.forEach(function(s) { %>
      <option value="<%= s %>" <%= s === massCenter.status ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <p class="muted">Current coordinates: <%= massCenter.latitude %>, <%= massCenter.longitude %></p>
  <label for="latitude">Latitude / Longitude <span class="muted">(optional — only to override; leave blank to keep current, or re-geocode by changing the address)</span></label>
  <div style="display:flex;gap:0.5rem;">
    <input type="text" id="latitude" name="latitude" placeholder="Latitude">
    <input type="text" id="longitude" name="longitude" placeholder="Longitude">
  </div>

  <button type="submit">Save</button>
</form>

<%- include('../partials/footer') %>
