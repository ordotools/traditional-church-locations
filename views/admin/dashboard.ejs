<%- include('../partials/header', { title: 'Dashboard' }) %>

<div class="stat-row">
  <a class="stat" href="/admin/mass-centers">
    <span class="n"><%= massCenterCount %></span>
    <span class="label">Mass Centers</span>
  </a>
  <a class="stat" href="/admin/organizations">
    <span class="n"><%= organizationCount %></span>
    <span class="label">Organizations</span>
  </a>
  <a class="stat" href="/admin/review">
    <span class="n"><%= reviewCount %></span>
    <span class="label">Awaiting Scrape Review</span>
  </a>
  <a class="stat" href="/admin/candidates">
    <span class="n"><%= geolocationCount %></span>
    <span class="label">Awaiting Geolocation</span>
  </a>
</div>

<h2>Add a pin</h2>
<p>Add a single address by hand from the <a href="/admin/mass-centers">Mass Centers</a> page,
   or <a href="/admin/scrape">scrape a URL</a> to find several addresses at once. Scraped
   results go through two queues before they reach the map: first
   <a href="/admin/review">Scrape Review</a>, where you approve or delete raw scrape results,
   then the <a href="/admin/candidates">Geolocation Queue</a>, where approved results get
   geocoded and confirmed as pins.</p>

<%- include('../partials/footer') %>
