<%- include('../partials/header', { title: 'Mass Centers', bodyClass: 'fit-viewport wide' }) %>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<div class="two-col">
  <div>
    <h2>Existing mass centers</h2>
    <div class="list-filters">
      <input type="search" id="mc-search" placeholder="Search by name or address…">
      <select id="mc-org-filter">
        <option value="">All organizations</option>
        <% organizations.forEach(function(org) { %>
          <option value="<%= org.id %>"><%= org.name %> (<%= org.abbreviation %>)</option>
        <% }) %>
      </select>
    </div>
    <% if (massCenters.length > 0) { %>
      <form id="bulk-delete" method="post" action="/admin/mass-centers/bulk-delete"
        hx-post="/admin/mass-centers/bulk-delete" hx-select="#mc-rows" hx-target="#mc-rows" hx-swap="outerHTML"
        hx-confirm="Delete the selected mass centers? This cannot be undone."></form>
    <% } %>
    <div class="scroll-table">
      <table>
        <thead>
          <tr>
            <th><input type="checkbox" id="mc-select-all"></th>
            <th>Title</th><th>Address</th><th>Organization</th><th></th>
          </tr>
        </thead>
        <tbody id="mc-rows">
          <% massCenters.forEach(function(mc) { %>
            <tr data-org="<%= mc.organization_id || '' %>" data-search="<%= (mc.title + ' ' + mc.address).toLowerCase() %>">
              <td><input class="mc-select" type="checkbox" form="bulk-delete" name="ids" value="<%= mc.id %>"></td>
              <td><%= mc.title %></td>
              <td><%= mc.address %></td>
              <td><%= mc.organization_abbreviation || '' %></td>
              <td class="actions">
                <a href="/admin/mass-centers/<%= mc.id %>/edit">Edit</a>
                &nbsp;
                <form method="post" action="/admin/mass-centers/<%= mc.id %>/delete"
                  hx-post="/admin/mass-centers/<%= mc.id %>/delete" hx-select="#mc-rows" hx-target="#mc-rows" hx-swap="outerHTML"
                  hx-confirm="Delete this pin?">
                  <button type="submit" class="secondary">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (massCenters.length === 0) { %>
            <tr><td colspan="5" class="muted">No mass centers yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (massCenters.length > 0) { %>
      <button type="submit" form="bulk-delete" class="secondary">Delete Selected</button>
    <% } %>
  </div>

  <div>
    <h2>Add mass center</h2>
    <form method="post" action="/admin/mass-centers">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" placeholder="e.g. Queen of All Saints Chapel" required>

      <label for="address">Address</label>
      <input type="text" id="address" name="address" placeholder="Street, City, State, ZIP" required>

      <label for="organization_id">Organization</label>
      <select id="organization_id" name="organization_id">
        <option value="">—</option>
        <% organizations.forEach(function(org) { %>
          <option value="<%= org.id %>"><%= org.name %> (<%= org.abbreviation %>)</option>
        <% }) %>
      </select>

      <label for="latitude">Latitude / Longitude <span class="muted">(optional — only if geocoding fails or is wrong)</span></label>
      <div style="display:flex;gap:0.5rem;">
        <input type="text" id="latitude" name="latitude" placeholder="Latitude">
        <input type="text" id="longitude" name="longitude" placeholder="Longitude">
      </div>

      <button type="submit">Geocode &amp; Add</button>
    </form>
  </div>
</div>

<script>
  (function () {
    var search = document.getElementById('mc-search');
    var orgFilter = document.getElementById('mc-org-filter');

    function applyFilters() {
      var q = search.value.trim().toLowerCase();
      var org = orgFilter.value;
      document.querySelectorAll('#mc-rows tr[data-search]').forEach(function (row) {
        var matchesSearch = !q || row.dataset.search.indexOf(q) !== -1;
        var matchesOrg = !org || row.dataset.org === org;
        row.style.display = matchesSearch && matchesOrg ? '' : 'none';
      });
    }

    search.addEventListener('input', applyFilters);
    orgFilter.addEventListener('change', applyFilters);
    // #mc-rows is swapped wholesale by htmx after a delete — the server
    // response is unfiltered, so re-apply the current search/org filter.
    document.body.addEventListener('htmx:afterSwap', function (e) {
      if (e.detail.target.id === 'mc-rows') applyFilters();
    });

    var selectAll = document.getElementById('mc-select-all');
    if (selectAll) {
      selectAll.addEventListener('click', function () {
        document.querySelectorAll('.mc-select').forEach(function (cb) {
          if (cb.closest('tr').style.display !== 'none') cb.checked = selectAll.checked;
        });
      });
    }
  })();
</script>

<%- include('../partials/footer') %>
