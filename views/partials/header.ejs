<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <% var isActive = function(prefix) { return prefix === '/' ? currentPath === '/' : currentPath.indexOf(prefix) === 0; }; %>
  <nav class="admin-nav">
    <a href="/admin" class="<%= isActive('/') ? 'active' : '' %>">Dashboard</a>
    <a href="/admin/mass-centers" class="<%= isActive('/mass-centers') ? 'active' : '' %>">Mass Centers</a>
    <a href="/admin/organizations" class="<%= isActive('/organizations') ? 'active' : '' %>">Organizations</a>
    <a href="/admin/scrape" class="<%= isActive('/scrape') ? 'active' : '' %>">Scrape URL</a>
    <a href="/admin/review" class="<%= isActive('/review') ? 'active' : '' %>">Scrape Review<% if (reviewCount) { %> <span class="badge"><%= reviewCount %></span><% } %></a>
    <a href="/admin/candidates" class="<%= isActive('/candidates') ? 'active' : '' %>">Geolocation Queue<% if (geolocationCount) { %> <span class="badge"><%= geolocationCount %></span><% } %></a>
    <a href="/admin/duplicates" class="<%= isActive('/duplicates') ? 'active' : '' %>">Duplicates</a>
    <a href="/">View Map</a>
    <form method="post" action="/admin/logout" class="logout-form"><button type="submit">Log out</button></form>
  </nav>
  <div class="container">
    <h1><%= title %></h1>
